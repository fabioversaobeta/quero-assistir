# URL da API. No emulador Android use http://10.0.2.2:3000; em aparelho físico, o IP da sua máquina.
EXPO_PUBLIC_API_URL=http://localhost:3000
# Client ID OAuth "Web" (o mesmo cadastrado em GOOGLE_CLIENT_IDS da API) — usado para obter o idToken
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Esquema de URL reverso do client iOS: com.googleusercontent.apps.<id>
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
