# --- Banco ---
DATABASE_URL=postgresql://quero:quero@localhost:5433/quero_assistir

# --- HTTP ---
PORT=3000
CORS_ORIGINS=http://localhost:3001

# --- Auth ---
# Segredo para assinar os JWTs da API (>= 32 chars). Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-longo-com-no-minimo-32-caracteres
JWT_EXPIRES_IN_SECONDS=2592000
# Client IDs OAuth do Google aceitos como audience do idToken (web do admin, android, ios), separados por vírgula
GOOGLE_CLIENT_IDS=
# E-mails que recebem papel ADMIN ao logar (separados por vírgula)
ADMIN_EMAILS=

# --- TMDB (https://www.themoviedb.org/settings/api) ---
TMDB_API_TOKEN=
TMDB_LANGUAGE=pt-BR
TMDB_REGION=BR
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# --- Sincronização ---
# Roda o cron dentro do processo da API. Em Railway pode-se preferir um Cron Service chamando `pnpm sync`.
SYNC_SCHEDULER_ENABLED=true
SYNC_CRON=0 5 * * *
SYNC_TIMEZONE=America/Sao_Paulo
# Quantas páginas (20 itens cada) do discover buscar por provedor/tipo
SYNC_STREAMING_PAGES=3
